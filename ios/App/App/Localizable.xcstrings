    },
    "Clara has too many payments waiting. Open Clara to review them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara tiene demasiados pagos esperando. Abre Clara para revisarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara a trop de paiements en attente. Ouvrez Clara pour les vérifier."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clara tem pagamentos demais esperando. Abra o Clara para revisá-los."
          }
        }
      }
    },
    "How much was the payment?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿De cuánto fue el pago?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien était le paiement ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De quanto foi o pagamento?"
          }
        }
      }
    },
