{
  "sourceLanguage": "en",
  "strings": {
    "Adds a payment for Clara to review. Clara reads it the next time it opens. Nothing leaves your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota un pago para revisarlo en Clara. Clara lo lee la próxima vez que se abre. Nada sale de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note un paiement à vérifier dans Clara. Clara le lit à sa prochaine ouverture. Rien ne quitte votre iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota um pagamento para revisar no Clara. O Clara o lê na próxima vez que abrir. Nada sai do seu iPhone."
          }
        }
      }
    },
    "Adds the text of a bank alert (an SMS or a notification) for Clara to read. Clara shows it to review the next time it opens. Nothing leaves your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota el texto de un aviso del banco (un SMS o una notificación) para que Clara lo lea. Clara lo muestra para revisar la próxima vez que se abre. Nada sale de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note le texte d’une alerte de la banque (un SMS ou une notification) pour que Clara le lise. Clara l’affiche à vérifier à sa prochaine ouverture. Rien ne quitte votre iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota o texto de um aviso do banco (um SMS ou uma notificação) para o Clara ler. O Clara o mostra para revisar na próxima vez que abrir. Nada sai do seu iPhone."
          }
        }
      }
    },
    "Alert text": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto del aviso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte de l’alerte"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto do aviso"
          }
        }
      }
    },
