    "Opens Clara on the form to add an expense. Nothing is saved until you tap Save.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Clara en el formulario para anotar un gasto. No se guarda nada hasta que tocas Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Clara sur le formulaire pour noter une dépense. Rien n’est enregistré tant que vous n’appuyez pas sur Enregistrer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Clara no formulário para anotar uma despesa. Nada é salvo até você tocar em Salvar."
          }
        }
      }
    },
    "Opens Clara on the screen you choose.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Clara en la pantalla que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Clara sur l’écran choisi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Clara na tela que você escolher."
          }
        }
      }
    },
