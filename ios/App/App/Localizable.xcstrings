          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartão"
          }
        }
      }
    },
    "Clara has too many payments waiting. Open Clara to review them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara tiene demasiados pagos esperando. Abre Clara para revisarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara a trop de paiements en attente. Ouvrez Clara pour les vérifier."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clara tem pagamentos demais esperando. Abra o Clara para revisá-los."
          }
        }
      }
    },
    "Clara: %@ at %@, to review": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara: %1$@ en %2$@, por revisar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara : %1$@ chez %2$@, à vérifier"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara: %1$@ em %2$@, para revisar"
          }
        }
      }
    },
    "Clara: %@, to review": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
