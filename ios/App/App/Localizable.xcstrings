          }
        }
      }
    },
    "Clara has too many payments waiting. Open Clara to review them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara tiene demasiados pagos esperando. Abre Clara para revisarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara a trop de paiements en attente. Ouvrez Clara pour les vérifier."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Clara tem pagamentos demais esperando. Abra o Clara para revisá-los."
          }
        }
      }
    },
    "Clara screen": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla de Clara"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écran de Clara"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela do Clara"
          }
        }
      }
    },
    "Clara: %@ at %@, to review": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara: %1$@ en %2$@, por revisar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara : %1$@ chez %2$@, à vérifier"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clara: %1$@ em %2$@, para revisar"
          }
        }
      }
    },
