{
  "sourceLanguage": "en",
  "strings": {
    "Adds a payment for Clara to review. Clara reads it the next time it opens. Nothing leaves your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota un pago para revisarlo en Clara. Clara lo lee la próxima vez que se abre. Nada sale de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note un paiement à vérifier dans Clara. Clara le lit à sa prochaine ouverture. Rien ne quitte votre iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota um pagamento para revisar no Clara. O Clara o lê na próxima vez que abrir. Nada sai do seu iPhone."
          }
        }
      }
    },
    "Amount": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montant"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor"
          }
        }
      }
    },
    "Amount as text": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe como texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montant en texte"
          }
        },
        "pt": {
          "stringUnit": {
